{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/((?!adhan/|adhkar/|tafsir/|quran/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(adhan|tafsir|adhkar|quran)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
